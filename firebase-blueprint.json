{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A portfolio project or creative deliverable displayed on the site.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Project title in English",
          "minLength": 1,
          "maxLength": 200
        },
        "title_ar": {
          "type": "string",
          "description": "Optional project title in Arabic",
          "maxLength": 200
        },
        "desc": {
          "type": "string",
          "description": "Short project description in English",
          "minLength": 1,
          "maxLength": 2000
        },
        "desc_ar": {
          "type": "string",
          "description": "Optional project description in Arabic",
          "maxLength": 2000
        },
        "image": {
          "type": "string",
          "description": "Project cover image URL or compressed data URI",
          "minLength": 1,
          "maxLength": 900000
        },
        "link": {
          "type": "string",
          "description": "Live preview or external URL",
          "minLength": 1,
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "description": "Project category identifier",
          "minLength": 1,
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the project was created"
        }
      },
      "required": ["title", "desc", "image", "link", "category", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Client testimonial submitted on the portfolio site.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Reviewer display name",
          "minLength": 1,
          "maxLength": 100
        },
        "text": {
          "type": "string",
          "description": "Review feedback content",
          "minLength": 1,
          "maxLength": 1000
        },
        "rating": {
          "type": "integer",
          "description": "Star rating from 1 to 5"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the review was submitted"
        }
      },
      "required": ["name", "text", "rating", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Private inquiry submitted through the portfolio contact form.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Sender name",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Sender email address",
          "minLength": 3,
          "maxLength": 150
        },
        "message": {
          "type": "string",
          "description": "Inquiry message body",
          "minLength": 1,
          "maxLength": 3000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the message was sent"
        }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Interactive UI visibility toggles managed from the admin dashboard.",
      "type": "object",
      "properties": {
        "show_slider": {
          "type": "boolean",
          "description": "Whether the project highlights slider is visible"
        },
        "show_sound": {
          "type": "boolean",
          "description": "Whether the sound toggle button is visible"
        },
        "show_chatbot": {
          "type": "boolean",
          "description": "Whether the AI assistant widget is visible"
        },
        "show_scroll_top": {
          "type": "boolean",
          "description": "Whether the scroll-to-top button is visible"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when settings were last updated"
        }
      },
      "required": ["show_slider", "show_sound", "show_chatbot", "show_scroll_top"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator registry document.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Publicly readable portfolio projects managed by admins."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Publicly readable client reviews with validated public creation and admin moderation."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Contact form submissions containing sender PII; write-once public create, admin-only read and delete."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Site UI configuration document (/settings/site); publicly readable, admin-writable."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin role documents readable only by the owner/admin."
    }
  }
}
